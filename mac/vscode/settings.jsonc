// https://zenn.dev/yutotnh/articles/1577b6dc5ab7d9
{
  "[code-workspace]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "files.trimTrailingWhitespace": false
  },
  "[snippets]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "accessibility.signals.chatEditModifiedFile": {
    "sound": "off"
  },
  "accessibility.signals.chatRequestSent": {
    "sound": "off"
  },
  "accessibility.signals.chatResponseReceived": {
    "sound": "off"
  },
  "accessibility.signals.clear": {
    "sound": "off"
  },
  "accessibility.signals.codeActionApplied": {
    "sound": "off"
  },
  "accessibility.signals.codeActionTriggered": {
    "sound": "off"
  },
  "accessibility.signals.diffLineDeleted": {
    "sound": "off"
  },
  "accessibility.signals.diffLineInserted": {
    "sound": "off"
  },
  "accessibility.signals.diffLineModified": {
    "sound": "off"
  },
  "accessibility.signals.editsKept": {
    "sound": "off"
  },
  "accessibility.signals.editsUndone": {
    "sound": "off"
  },
  "accessibility.signals.lineHasBreakpoint": {
    "sound": "off"
  },
  "accessibility.signals.lineHasError": {
    "sound": "off"
  },
  "accessibility.signals.lineHasFoldedArea": {
    "sound": "off"
  },
  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "off"
  },
  "accessibility.signals.lineHasWarning": {
    "sound": "off"
  },
  "accessibility.signals.noInlayHints": {
    "sound": "off"
  },
  "accessibility.signals.notebookCellCompleted": {
    "sound": "off"
  },
  "accessibility.signals.notebookCellFailed": {
    "sound": "off"
  },
  "accessibility.signals.onDebugBreak": {
    "sound": "off"
  },
  "accessibility.signals.positionHasError": {
    "sound": "off"
  },
  "accessibility.signals.positionHasWarning": {
    "sound": "off"
  },
  "accessibility.signals.progress": {
    "sound": "off"
  },
  "accessibility.signals.terminalBell": {
    "sound": "off"
  },
  "accessibility.signals.terminalCommandFailed": {
    "sound": "off"
  },
  "accessibility.signals.terminalCommandSucceeded": {
    "sound": "off"
  },
  "accessibility.signals.terminalQuickFix": {
    "sound": "off"
  },
  "accessibility.signals.voiceRecordingStarted": {
    "sound": "off"
  },
  "accessibility.signals.voiceRecordingStopped": {
    "sound": "off"
  },
  "biome.enabled": false,
  "cSpell.enabled": true,
  "cSpell.userWords": [
    "totto"
  ],
  "css.lint.unknownAtRules": "ignore",
  "deno.enable": false,
  "deno.path": "",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.accessibilitySupport": "auto",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.dragAndDrop": false,
  "editor.fontFamily": "PlemolJP Console",
  "editor.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.highlightActiveBracketPair": true,
  "editor.linkedEditing": true,
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "all",
  "editor.showFoldingControls": "always",
  "editor.wrappingIndent": "indent",
  "emmet.triggerExpansionOnTab": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "Dockerfile": "Containerfile*, Dockerfile*, *.Containerfile, *.Dockerfile, compose.*, docker-compose.*, .containerignore, .dockerignore",
    "package.json": "turbo.json, drizzle.config.*, tsdown.config.*, tsr.config.*, ui.*, wrangler.*, .dev.vars, worker-configuration.*, biome.*, dprint.*, eslint.config.*, .eslintrc*, prettier.config.*, .prettierrc*, vite.config.*, vitest.config.*, tsconfig.*, tailwind.*, pnpm-lock.yaml, package-lock.json, bun.lockb, yarn.lock, .npmrc, pncat.*, pnpm-workspace.*, tamagui.config.*, tamagui.theme.*, vercel.*, react-router.*",
    "Pulumi.yaml": "Pulumi.*",
    "README.md": ".gitignore, .editorconfig, LICENSE, renovate.*, *.code-workspace,  AGENTS.md, CLAUDE.md, GEMINI.md, .mcp.*, .env*, mise.*, devbox.*, Taskfile.*, lefthook.*"
  },
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/.devbox/": true,
    // file
    "**/.DS_Store": true,
    "**/.react-router/": true,
    "**/.serena/": true,
    "**/.tamagui/": true,
    "**/.tanstack/": true,
    "**/.turbo/": true,
    "**/.vercel/": true,
    "**/.wrangler/": true,
    "**/build/": true,
    // generic
    "**/dist/": true,
    // JS
    "**/node_modules/": true,
    "**/storybook-static/": true,
    "**/test-results/": true
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": "all",
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "git.pruneOnFetch": true,
  "githubPullRequests.fileListLayout": "tree",
  "githubPullRequests.pullBranch": "always",
  "go.toolsManagement.autoUpdate": true,
  "html.completion.attributeDefaultValue": "empty",
  "javascript.autoClosingTags": true,
  "javascript.preferences.jsxAttributeCompletionStyle": "none",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "json.schemaDownload.enable": true,
  "scm.alwaysShowRepositories": true,
  "scm.defaultViewMode": "tree",
  "scm.diffDecorationsGutterWidth": 5,
  "scm.inputFontFamily": "editor",
  "security.workspace.trust.enabled": true,
  "tailwindCSS.classFunctions": [
    "cva",
    "cx",
    "tv"
  ],
  "tailwindCSS.emmetCompletions": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontFamily": "PlemolJP Console NF",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.smoothScrolling": true,
  "typescript.autoClosingTags": true,
  "typescript.preferences.jsxAttributeCompletionStyle": "none",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vim.easymotion": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.insertModeKeyBindings": [
    {
      "after": [
        "<Esc>"
      ],
      "before": [
        "j",
        "j"
      ]
    }
  ],
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "after": [
        "\"",
        "_",
        "x"
      ],
      "before": [
        "x"
      ]
    },
    {
      "after": [
        "\"",
        "_",
        "c"
      ],
      "before": [
        "c"
      ]
    },
    {
      "after": [
        "\"",
        "_",
        "s"
      ],
      "before": [
        "s"
      ]
    },
    {
      "before": [
        "K"
      ],
      "commands": [
        {
          "command": "editor.action.showHover"
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        {
          "command": "workbench.view.explorer"
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "r"
      ],
      "commands": [
        {
          "command": "editor.action.rename"
        }
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "a"
      ],
      "commands": [
        {
          "command": "editor.action.quickFix"
        }
      ]
    }
  ],
  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": true,
  "workbench.auxiliaryActivityBar.location": "default",
  "workbench.colorTheme": "Ayu Mirage Bordered",
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.editor.wrapTabs": true,
  "workbench.iconTheme": "vscode-icons",
  "workbench.list.smoothScrolling": true,
  "workbench.panel.showLabels": false
}
