{
  "[json]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "deno.enable": true,
  "deno.lint": true,
  "editor.formatOnSave": true,
  "cSpell.words": [
    "Anson",
    "autofetch",
    "Containerfile",
    "containerignore",
    "devbox",
    "easymotion",
    "hlsearch",
    "incsearch",
    "Plemol",
    "pncat",
    "Pulumi",
    "tamagui",
    "Taskfile"
  ]
}
